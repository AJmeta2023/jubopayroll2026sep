      document.getElementById('form-mealAllowance').value = "3000";
      document.getElementById('form-overtime').value = "0";
      document.getElementById('form-bonus').value = "0";
      document.getElementById('form-pensionPlus').value = "0";
      document.getElementById('form-otherPlus').value = "0";
      document.getElementById('form-leaveDeduction').value = "0";
      document.getElementById('form-laborInsurance').value = "0";
      document.getElementById('form-healthInsurance').value = "0";
      document.getElementById('form-pensionMinus').value = "0";
      document.getElementById('form-otherMinus').value = "0";
