    // 預覽下拉選單
    function renderPreviewOptions() {
      const select = document.getElementById('preview-select');
      select.innerHTML = '';
      salaryData.forEach((emp, index) => {
        const option = document.createElement('option');
        option.value = emp.id;
        option.textContent = `${emp.code} - ${emp.name}`;
        if (emp.id === currentSelectedId) option.selected = true;
        select.appendChild(option);
      });
      if (salaryData.length > 0 && !salaryData.some(e => e.id === currentSelectedId)) {
        currentSelectedId = salaryData[0].id;
      }
    }

    function prevEmployee() {
      const index = salaryData.findIndex(e => e.id === currentSelectedId);
      if (index > 0) {
        currentSelectedId = salaryData[index - 1].id;
        document.getElementById('preview-select').value = currentSelectedId;
        renderCurrentPreview();
      }
    }

    function nextEmployee() {
      const index = salaryData.findIndex(e => e.id === currentSelectedId);
      if (index < salaryData.length - 1) {
        currentSelectedId = salaryData[index + 1].id;
        document.getElementById('preview-select').value = currentSelectedId;
        renderCurrentPreview();
      }
    }

    /* ==========================================================================
       核心功能：原生 2D CANVAS 繪製引擎
       保證 100% 不漏格線、不掉字、跨平台高清晰輸出
       ========================================================================== */
    function drawPayslipToCanvas(canvas, emp) {
      const ctx = canvas.getContext('2d');
      const dpr = 2; // 2x 超高畫質抗鋸齒
      const W = 1100;
      const H = 470;

      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';

      ctx.save();
      ctx.scale(dpr, dpr);

      // 1. 底色與外圍卡片圓角
      ctx.fillStyle = '#ffffff';
      roundRect(ctx, 0, 0, W, H, 16, true, false);

      // 外邊框
      ctx.strokeStyle = '#cbd5e1';
      ctx.lineWidth = 1.5;
      roundRect(ctx, 1, 1, W - 2, H - 2, 16, false, true);

      // 2. 頂部抬頭區
      const company = document.getElementById('config-company').value.trim() || '聚勃國際股份有限公司';
      const title = document.getElementById('config-title').value.trim() || '薪資明細';
      const period = document.getElementById('config-period').value.trim() || '';

      // 公司抬頭
      ctx.fillStyle = '#0f172a';
      ctx.font = 'bold 28px "Noto Sans TC", sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillText(company, W / 2, 28);

      // 月份薪資明細
      ctx.fillStyle = '#334155';
      ctx.font = 'bold 20px "Noto Sans TC", sans-serif';
      ctx.fillText(title, W / 2, 70);

      // 資訊條 (員工編號、姓名、計薪期間)
      const metaY = 112;
      ctx.textBaseline = 'middle';

      // 員工編號
      ctx.textAlign = 'left';
      ctx.font = 'normal 15px "Noto Sans TC", sans-serif';
      ctx.fillStyle = '#475569';
      ctx.fillText('員工編號：', 40, metaY);
      ctx.font = 'bold 16px "Noto Sans TC", monospace';
      ctx.fillStyle = '#0f172a';
      ctx.fillText(emp.code || '-', 115, metaY);

      // 姓名
      ctx.textAlign = 'left';
      ctx.font = 'normal 15px "Noto Sans TC", sans-serif';
      ctx.fillStyle = '#475569';
      ctx.fillText('姓名：', 420, metaY);
      ctx.font = 'bold 18px "Noto Sans TC", sans-serif';
      ctx.fillStyle = '#0f172a';
      ctx.fillText(emp.name || '-', 465, metaY);

      // 計薪期間
      if (period) {
        ctx.textAlign = 'right';
        ctx.font = 'normal 14px "Noto Sans TC", sans-serif';
        ctx.fillStyle = '#475569';
        ctx.fillText(`計薪期間：${period}`, W - 40, metaY);
      }

      // 分隔線
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(40, 134);
      ctx.lineTo(W - 40, 134);
      ctx.stroke();

      /* 3. 薪資表格向量繪製
         總共 15 個細項直欄：
         0~6: 應發 (固定薪資, 伙食津, 加班, 獎金, 自提退, 其他加項, 加項小計) -> 7欄
         7~12: 應扣 (請假, 勞保費, 健保費, 自提退, 其他減項, 減項小計) -> 6欄
         13: 合計 (A)-(B)
         14: 備註
      */
      const tableX = 40;
      const tableY = 155;
      const tableW = W - 80; // 1020px
      const row1H = 38; // 第一層表頭高度
      const row2H = 46; // 第二層表頭高度
      const dataRowH = 50; // 數值列高度
      const totalTableH = row1H + row2H + dataRowH; // 134px

      // 欄寬精確分配 (合計 1020px)
      const colWidths = [
        68, 62, 54, 54, 54, 68, 76,   // 應發 7 欄 (共 436px)
        54, 62, 62, 54, 68, 76,       // 應扣 6 欄 (共 376px)
        110,                          // 合計 (A)-(B) (110px)
        98                            // 備註 (98px)
      ];

      // 計算每個縱欄的 X 起點
      const colX = [tableX];
      for (let i = 0; i < colWidths.length; i++) {
        colX.push(colX[i] + colWidths[i]);
      }

      // (A) 區塊背景色彩填色
      // 應發項目背景
      ctx.fillStyle = '#f0f9ff'; // sky-50
      ctx.fillRect(colX[0], tableY, colX[7] - colX[0], totalTableH);
      ctx.fillStyle = '#e0f2fe'; // sky-100 加項小計直欄加深
      ctx.fillRect(colX[6], tableY + row1H, colWidths[6], row2H + dataRowH);

      // 應扣項目背景
      ctx.fillStyle = '#fff1f2'; // rose-50
      ctx.fillRect(colX[7], tableY, colX[13] - colX[7], totalTableH);
      ctx.fillStyle = '#ffe4e6'; // rose-100 減項小計直欄加深
      ctx.fillRect(colX[12], tableY + row1H, colWidths[12], row2H + dataRowH);

      // 合計背景
      ctx.fillStyle = '#ecfdf5'; // emerald-50
      ctx.fillRect(colX[13], tableY, colWidths[13], totalTableH);

      // 備註背景
      ctx.fillStyle = '#f8fafc'; // slate-50
      ctx.fillRect(colX[14], tableY, colWidths[14], totalTableH);

      // (B) 繪製所有儲存格格線 (精準 1px 向量繪製，不缺線)
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 1;

      // 橫線
      ctx.beginPath();
      ctx.moveTo(tableX, tableY);
      ctx.lineTo(tableX + tableW, tableY);

      ctx.moveTo(tableX, tableY + row1H);
      ctx.lineTo(colX[13], tableY + row1H); // 第 1 層底線 (止於合計前)

      ctx.moveTo(tableX, tableY + row1H + row2H);
      ctx.lineTo(tableX + tableW, tableY + row1H + row2H); // 第 2 層底線

      ctx.moveTo(tableX, tableY + totalTableH);
      ctx.lineTo(tableX + tableW, tableY + totalTableH); // 表格底線
      ctx.stroke();

      // 直線
      for (let i = 0; i <= colWidths.length; i++) {
        const x = colX[i];
        ctx.beginPath();
        if (i === 0 || i === colWidths.length || i === 7 || i === 13 || i === 14) {
          // 貫穿全表格的大隔線 (外框、應發/應扣分界、合計分界、備註分界)
          ctx.moveTo(x, tableY);
          ctx.lineTo(x, tableY + totalTableH);
        } else {
          // 僅在第二層及資料列顯示的細分線
          ctx.moveTo(x, tableY + row1H);
          ctx.lineTo(x, tableY + totalTableH);
        }
        ctx.stroke();
      }

      // 表格加強外框
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(tableX, tableY, tableW, totalTableH);

      // (C) 繪製文字與數值
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      // 第一層大標題
      ctx.font = 'bold 15px "Noto Sans TC", sans-serif';
      ctx.fillStyle = '#0369a1';
      ctx.fillText('應發金額 (A)', (colX[0] + colX[7]) / 2, tableY + row1H / 2);

      ctx.fillStyle = '#be123c';
      ctx.fillText('應扣金額 (B)', (colX[7] + colX[13]) / 2, tableY + row1H / 2);

      // 合計大標題
      ctx.fillStyle = '#065f46';
      ctx.font = 'bold 15px "Noto Sans TC", sans-serif';
      ctx.fillText('合計', colX[13] + colWidths[13] / 2, tableY + row1H / 2);

      // 備註大標題 (垂直完全居中)
      ctx.fillStyle = '#0f172a';
      ctx.font = 'bold 15px "Noto Sans TC", sans-serif';
      ctx.fillText('備註', colX[14] + colWidths[14] / 2, tableY + (row1H + row2H) / 2);

      // 第二層欄位細項文字
      const subHeaderTitles = [
        '固定薪資', '伙食津', '加班', '獎金', '自提退', '其他加項', '加項小計',
        '請假', '勞保費', '健保費', '自提退', '其他減項', '減項小計',
        '(A)-(B)'
      ];

      for (let i = 0; i < subHeaderTitles.length; i++) {
        const cx = colX[i] + colWidths[i] / 2;
        const cy = tableY + row1H + row2H / 2;
        if (i === 6) {
          ctx.fillStyle = '#0c4a6e';
          ctx.font = 'bold 12px "Noto Sans TC", sans-serif';
        } else if (i === 12) {
          ctx.fillStyle = '#881337';
          ctx.font = 'bold 12px "Noto Sans TC", sans-serif';
        } else if (i === 13) {
          ctx.fillStyle = '#065f46';
          ctx.font = 'bold 13px "Noto Sans TC", sans-serif';
        } else {
          ctx.fillStyle = '#334155';
          ctx.font = 'normal 12px "Noto Sans TC", sans-serif';
        }
        ctx.fillText(subHeaderTitles[i], cx, cy);
      }

      // 第三層：數據填入
      const gross = calcGross(emp);
      const deduction = calcDeduction(emp);
      const net = calcNet(emp);

      const rowValues = [
        formatMoney(emp.baseSalary),
        formatMoney(emp.mealAllowance),
        formatMoney(emp.overtime),
        formatMoney(emp.bonus),
        formatMoney(emp.pensionPlus),
        formatMoney(emp.otherPlus),
        formatMoney(gross),
        formatMoney(emp.leaveDeduction),
        formatMoney(emp.laborInsurance),
        formatMoney(emp.healthInsurance),
        formatMoney(emp.pensionMinus),
        formatMoney(emp.otherMinus),
        formatMoney(deduction),
        formatMoney(net)
      ];

      const dataY = tableY + row1H + row2H + dataRowH / 2;

      for (let i = 0; i < rowValues.length; i++) {
        const cx = colX[i] + colWidths[i] / 2;
        if (i === 6) {
          ctx.fillStyle = '#0369a1';
          ctx.font = 'bold 15px "Noto Sans TC", monospace';
        } else if (i === 12) {
          ctx.fillStyle = '#be123c';
          ctx.font = 'bold 15px "Noto Sans TC", monospace';
        } else if (i === 13) {
          ctx.fillStyle = '#047857';
          ctx.font = 'bold 18px "Noto Sans TC", monospace';
        } else {
          ctx.fillStyle = '#0f172a';
          ctx.font = 'normal 13px "Noto Sans TC", monospace';
        }
        ctx.fillText(rowValues[i], cx, dataY);
      }

      // 填寫備註文字 (自動限寬與截斷保護)
      ctx.textAlign = 'center';
      ctx.font = 'normal 12px "Noto Sans TC", sans-serif';
      ctx.fillStyle = '#334155';
      const noteText = (emp.note || '-').toString();
      const maxNoteW = colWidths[14] - 8;
      let displayNote = noteText;
      if (ctx.measureText(displayNote).width > maxNoteW) {
        while (ctx.measureText(displayNote + '...').width > maxNoteW && displayNote.length > 0) {
          displayNote = displayNote.substring(0, displayNote.length - 1);
        }
        displayNote += '...';
      }
      ctx.fillText(displayNote, colX[14] + colWidths[14] / 2, dataY);

      // 4. 底部備註提醒文字
      const footerNote = document.getElementById('config-footer-note').value.trim();
      if (footerNote) {
        ctx.textAlign = 'left';
        ctx.font = 'normal 12px "Noto Sans TC", sans-serif';
        ctx.fillStyle = '#64748b';
        ctx.fillText(footerNote, 40, tableY + totalTableH + 35);
      }

      ctx.restore();
    }

    // 圓角矩形輔助函數
    function roundRect(ctx, x, y, width, height, radius, fill, stroke) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
      if (fill) ctx.fill();
      if (stroke) ctx.stroke();
    }

