    function quickUpdate(id, field, value) {
      const emp = salaryData.find(x => x.id === id);
      if (emp) {
        emp[field] = field === 'note' ? value : (Number(value) || 0);
        renderTable();
        renderPreviewOptions();
        renderCurrentPreview();
      }
    }

    // 頁籤切換
    function switchTab(tab) {
      const btnTable = document.getElementById('tab-btn-table');
      const btnCards = document.getElementById('tab-btn-cards');
      const contentTable = document.getElementById('tab-content-table');
      const contentCards = document.getElementById('tab-content-cards');
      const tableToolbar = document.getElementById('table-toolbar');

      if (tab === 'table') {
        btnTable.className = "pb-3 text-sm font-bold border-b-2 border-indigo-600 text-indigo-600 flex items-center space-x-2";
        btnCards.className = "pb-3 text-sm font-bold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2";
        contentTable.classList.remove('hidden');
        contentCards.classList.add('hidden');
        tableToolbar.classList.remove('hidden');
