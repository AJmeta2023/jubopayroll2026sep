    function editEmployee(id) {
      const emp = salaryData.find(e => e.id === id);
      if (!emp) return;
      document.getElementById('modal-title').textContent = "編輯員工薪資資料";
      document.getElementById('form-id').value = emp.id;
      document.getElementById('form-code').value = emp.code;
      document.getElementById('form-name').value = emp.name;
      document.getElementById('form-baseSalary').value = emp.baseSalary;
      document.getElementById('form-mealAllowance').value = emp.mealAllowance;
      document.getElementById('form-overtime').value = emp.overtime;
      document.getElementById('form-bonus').value = emp.bonus;
      document.getElementById('form-pensionPlus').value = emp.pensionPlus;
      document.getElementById('form-otherPlus').value = emp.otherPlus;
      document.getElementById('form-leaveDeduction').value = emp.leaveDeduction;
      document.getElementById('form-laborInsurance').value = emp.laborInsurance;
      document.getElementById('form-healthInsurance').value = emp.healthInsurance;
      document.getElementById('form-pensionMinus').value = emp.pensionMinus;
      document.getElementById('form-otherMinus').value = emp.otherMinus;
      document.getElementById('form-note').value = emp.note || "";
      document.getElementById('employee-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('employee-modal').classList.add('hidden');
    }

    function handleSaveEmployee(e) {
      e.preventDefault();
      const id = document.getElementById('form-id').value;
      const empData = {
        code: document.getElementById('form-code').value.trim(),
        name: document.getElementById('form-name').value.trim(),
        baseSalary: Number(document.getElementById('form-baseSalary').value) || 0,
        mealAllowance: Number(document.getElementById('form-mealAllowance').value) || 0,
        overtime: Number(document.getElementById('form-overtime').value) || 0,
        bonus: Number(document.getElementById('form-bonus').value) || 0,
        pensionPlus: Number(document.getElementById('form-pensionPlus').value) || 0,
        otherPlus: Number(document.getElementById('form-otherPlus').value) || 0,
        leaveDeduction: Number(document.getElementById('form-leaveDeduction').value) || 0,
        laborInsurance: Number(document.getElementById('form-laborInsurance').value) || 0,
        healthInsurance: Number(document.getElementById('form-healthInsurance').value) || 0,
        pensionMinus: Number(document.getElementById('form-pensionMinus').value) || 0,
        otherMinus: Number(document.getElementById('form-otherMinus').value) || 0,
        note: document.getElementById('form-note').value.trim()
      };

      if (id) {
        const index = salaryData.findIndex(x => x.id === id);
        if (index !== -1) {
          salaryData[index] = { ...salaryData[index], ...empData };
        }
      } else {
        const newId = "emp-" + Date.now();
        salaryData.push({ id: newId, ...empData });
        currentSelectedId = newId;
      }

      closeModal();
      renderTable();
      renderPreviewOptions();
      renderCurrentPreview();
    }

    function deleteEmployee(id) {
      if (!confirm("確定要刪除這筆員工薪資資料嗎？")) return;
      salaryData = salaryData.filter(x => x.id !== id);
      if (currentSelectedId === id) {
        currentSelectedId = salaryData[0]?.id || "";
      }
      renderTable();
      renderPreviewOptions();
      renderCurrentPreview();
    }

    function clearAllData() {
      if (!confirm("警告：這將清空所有目前輸入與匯入的資料，確定執行？")) return;
      salaryData = [];
      currentSelectedId = "";
      renderTable();
      renderPreviewOptions();
      renderCurrentPreview();
    }

    function showLoading(text) {
      document.getElementById('loading-text').textContent = text;
      document.getElementById('loading-overlay').classList.remove('hidden');
    }

    function hideLoading() {
      document.getElementById('loading-overlay').classList.add('hidden');
    }
  </script>
