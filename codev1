    // 下載單張 PDF
    function downloadCurrentPDF() {
      const emp = salaryData.find(e => e.id === currentSelectedId);
      if (!emp) return;
      showLoading("正在生成 PDF 檔案...");

      setTimeout(() => {
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        const canvas = document.getElementById('preview-canvas');
        const imgData = canvas.toDataURL('image/png');

        const pdfWidth = pdf.internal.pageSize.getWidth();
        const pdfHeight = pdf.internal.pageSize.getHeight();
        const imgWidth = 260; // 留邊距
        const imgHeight = (canvas.height / canvas.width) * imgWidth;
        const x = (pdfWidth - imgWidth) / 2;
        const y = (pdfHeight - imgHeight) / 2;

        pdf.addImage(imgData, 'PNG', x, y, imgWidth, imgHeight);
        const company = document.getElementById('config-company').value.trim() || '公司';
        const title = document.getElementById('config-title').value.trim() || '薪資明細';
        pdf.save(`${company}_${emp.code}_${emp.name}_${title}.pdf`);
        hideLoading();
      }, 100);
    }

    // 打包全體員工圖片 (ZIP)
    async function downloadAllImagesZip() {
      if (salaryData.length === 0) {
        alert("目前沒有薪資資料可下載！");
        return;
      }
      showLoading("正在批次產出全體薪資圖片並打包 ZIP...");

      setTimeout(async () => {
        try {
          const zip = new JSZip();
          const exportCanvas = document.getElementById('export-canvas');
          const company = document.getElementById('config-company').value.trim() || '公司';
          const title = document.getElementById('config-title').value.trim() || '薪資明細';

          for (let i = 0; i < salaryData.length; i++) {
            const emp = salaryData[i];
            drawPayslipToCanvas(exportCanvas, emp);
            const dataUrl = exportCanvas.toDataURL('image/png');
            const base64Data = dataUrl.replace(/^data:image\/png;base64,/, "");
            const fileName = `${String(i + 1).padStart(2, '0')}_${emp.code}_${emp.name}_薪資單.png`;
            zip.file(fileName, base64Data, { base64: true });
          }

          const content = await zip.generateAsync({ type: "blob" });
          const link = document.createElement('a');
          link.href = URL.createObjectURL(content);
          link.download = `${company}_${title}_全體員工薪資圖檔.zip`;
          link.click();
          hideLoading();
        } catch (e) {
          console.error(e);
          hideLoading();
          alert("打包圖片時發生錯誤，請重試！");
        }
      }, 100);
    }

    // 下載全體合併 PDF 檔
    function downloadAllPDF() {
      if (salaryData.length === 0) {
        alert("目前沒有薪資資料可下載！");
        return;
      }
      showLoading("正在生成全體員工合併 PDF 檔案...");

      setTimeout(() => {
        try {
          const { jsPDF } = window.jspdf;
          const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
          const exportCanvas = document.getElementById('export-canvas');
          const pdfWidth = pdf.internal.pageSize.getWidth();
          const pdfHeight = pdf.internal.pageSize.getHeight();
