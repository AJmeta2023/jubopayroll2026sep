    /* ==========================================================================
       EXCEL 範本下載與檔案匯入處理
       ========================================================================== */
    function downloadExcelTemplate() {
      const headers = [
        ["聚勃國際股份有限公司 薪資匯入範本 (請勿變更欄位標題順序)"],
        [
          "員工編號", "姓名",
          "固定薪資", "伙食津", "加班", "獎金", "自提退(加)", "其他加項",
          "請假", "勞保費", "健保費", "自提退(扣)", "其他減項", "備註"
        ],
        [
          "JBE26001", "蕭宥萱", 73000, 3000, 0, 0, 0, 0, 0, 1145, 1187, 0, 0, ""
        ],
        [
          "JBE26038", "陳建豪", 42000, 3000, 2450, 5000, 0, 500, 0, 966, 720, 0, 0, "全勤"
        ]
      ];

      const ws = XLSX.utils.aoa_to_sheet(headers);
      ws['!merges'] = [{ s: { r: 0, c: 0 }, e: { r: 0, c: 13 } }];
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "薪資匯入範本");
      XLSX.writeFile(wb, "聚勃國際_薪資明細標準範本.xlsx");
    }

    function handleExcelUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const data = new Uint8Array(evt.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });

          if (rows.length < 2) {
            alert("Excel 檔案內容不足或空白！");
            return;
          }

          // 尋找標題列
          let headerIdx = -1;
          for (let r = 0; r < Math.min(rows.length, 6); r++) {
            const rowStr = (rows[r] || []).join(' ');
            if (rowStr.includes("姓名") || rowStr.includes("固定薪資") || rowStr.includes("員工編號")) {
              headerIdx = r;
              break;
            }
          }

          if (headerIdx === -1) {
            alert("找不到相符的薪資表頭，請下載並參照標準範本！");
            return;
          }

          const headers = rows[headerIdx].map(h => (h || '').toString().trim());
          const newEmps = [];

          for (let r = headerIdx + 1; r < rows.length; r++) {
            const row = rows[r];
            if (!row || row.length === 0 || (!row[0] && !row[1])) continue;

            const getCol = (keywords) => {
              for (let i = 0; i < headers.length; i++) {
                if (keywords.some(k => headers[i].includes(k))) {
                  return row[i];
                }
              }
              return 0;
            };

            const code = (getCol(["員工編號", "工號", "編號"]) || "").toString().trim();
            const name = (getCol(["姓名", "員工姓名"]) || "").toString().trim();
            if (!code && !name) continue;

            newEmps.push({
              id: "emp-" + Date.now() + "-" + Math.random().toString(36).substr(2, 5),
              code: code || `EMP${String(r).padStart(3, '0')}`,
              name: name || "未命名",
              baseSalary: Number(getCol(["固定薪資", "底薪", "本薪"])) || 0,
              mealAllowance: Number(getCol(["伙食津", "伙食費", "伙食津貼"])) || 0,
              overtime: Number(getCol(["加班", "加班費"])) || 0,
              bonus: Number(getCol(["獎金", "績效獎金"])) || 0,
              pensionPlus: Number(getCol(["自提退(加)", "自提(加)", "退(加)"])) || 0,
              otherPlus: Number(getCol(["其他加項", "其他加"])) || 0,
              leaveDeduction: Number(getCol(["請假", "請假扣款", "事病假"])) || 0,
              laborInsurance: Number(getCol(["勞保費", "勞保"])) || 0,
              healthInsurance: Number(getCol(["健保費", "健保"])) || 0,
              pensionMinus: Number(getCol(["自提退(扣)", "自提(扣)", "勞退自提", "自提退"])) || 0,
              otherMinus: Number(getCol(["其他減項", "其他扣", "其他減"])) || 0,
              note: (getCol(["備註", "說明"]) || "").toString().trim()
            });
          }

          if (newEmps.length > 0) {
            salaryData = newEmps;
            currentSelectedId = salaryData[0].id;
            renderTable();
            renderPreviewOptions();
            renderCurrentPreview();
            alert(`成功匯入 ${newEmps.length} 筆員工薪資資料！`);
          } else {
            alert("未讀取到有效的員工資料，請確認檔案格式！");
          }
        } catch (err) {
          console.error(err);
          alert("解析 Excel 檔案發生錯誤：" + err.message);
        }
        e.target.value = '';
      };
      reader.readAsArrayBuffer(file);
    }

