            const imgHeight = (exportCanvas.height / exportCanvas.width) * imgWidth;
            const x = (pdfWidth - imgWidth) / 2;
            const y = (pdfHeight - imgHeight) / 2;
            pdf.addImage(imgData, 'PNG', x, y, imgWidth, imgHeight);
          });

          const company = document.getElementById('config-company').value.trim() || '公司';
          const title = document.getElementById('config-title').value.trim() || '薪資明細';
          pdf.save(`${company}_${title}_全體薪資單.pdf`);
          hideLoading();
        } catch (e) {
          console.error(e);
