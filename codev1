       ========================================================================== */
    // 下載單張 PNG
    function downloadCurrentPNG() {
      const emp = salaryData.find(e => e.id === currentSelectedId);
      if (!emp) return;
      const canvas = document.getElementById('preview-canvas');
      const dataUrl = canvas.toDataURL('image/png');
      const link = document.createElement('a');
      const company = document.getElementById('config-company').value.trim() || '公司';
      const title = document.getElementById('config-title').value.trim() || '薪資明細';
      link.download = `${company}_${emp.code}_${emp.name}_${title}.png`;
