<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>薪資明細生成與管理系統</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SheetJS (xlsx) for Excel processing -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <!-- JSZip for batch image packaging -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <!-- jsPDF for direct PDF output -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;900&display=swap');
    body {
      font-family: 'Noto Sans TC', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #f1f5f9;
    }
    @media print {
      body * {
        visibility: hidden;
      }
      #print-area, #print-area * {
        visibility: visible;
      }
      #print-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 0;
      }
      .page-break {
        page-break-after: always;
        break-after: page;
      }
      @page {
        size: A4 portrait;
        margin: 12mm;
      }
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- 頂部導航列 -->
  <header class="bg-slate-900 text-white shadow-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="p-2 bg-indigo-600 rounded-lg">
          <i data-lucide="file-spreadsheet" class="w-6 h-6"></i>
        </div>
        <div>
          <h1 class="text-lg font-bold tracking-wide" id="nav-company-name">聚勃國際股份有限公司</h1>
          <p class="text-xs text-slate-400" id="nav-period">薪資明細生成與管理系統</p>
        </div>
      </div>
      <div class="flex items-center space-x-2">
        <button onclick="downloadExcelTemplate()" class="flex items-center space-x-1.5 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium rounded-lg border border-slate-700 transition">
          <i data-lucide="download" class="w-4 h-4"></i>
          <span>下載 Excel 範本</span>
        </button>
        <label class="cursor-pointer flex items-center space-x-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
          <i data-lucide="upload" class="w-4 h-4"></i>
          <span>匯入 EXCEL 檔</span>
          <input type="file" id="excel-file-input" accept=".xlsx, .xls, .csv" class="hidden" onchange="handleExcelUpload(event)">
        </label>
        <button onclick="downloadAllPDF()" class="flex items-center space-x-1.5 px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
          <i data-lucide="file-down" class="w-4 h-4"></i>
          <span>下載全體 PDF 檔</span>
        </button>
        <button onclick="downloadAllImagesZip()" class="flex items-center space-x-1.5 px-3.5 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
          <i data-lucide="archive" class="w-4 h-4"></i>
          <span>下載全體圖片 (ZIP)</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 主工作區 -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">

    <!-- 系統控制與配置面板 -->
    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200/80">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">公司名稱</label>
          <input type="text" id="config-company" value="聚勃國際股份有限公司" oninput="updateConfig()" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">薪資月份標題</label>
          <input type="text" id="config-title" value="2026年08月薪資明細" oninput="updateConfig()" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">計薪期間</label>
          <input type="text" id="config-period" value="2026/08/01 ~ 2026/08/31" oninput="updateConfig()" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">底部備註提醒</label>
          <input type="text" id="config-footer-note" value="※ 本明細表若有任何疑義，請於收到三日內向HR或總管理處洽詢確認。" oninput="updateConfig()" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>
      </div>
    </div>

    <!-- 功能頁籤切換 -->
    <div class="flex items-center justify-between border-b border-slate-200">
      <div class="flex space-x-6">
        <button onclick="switchTab('table')" id="tab-btn-table" class="pb-3 text-sm font-bold border-b-2 border-indigo-600 text-indigo-600 flex items-center space-x-2">
          <i data-lucide="layout-grid" class="w-4 h-4"></i>
          <span>薪資總表編輯 (<span id="count-badge">0</span> 人)</span>
        </button>
        <button onclick="switchTab('cards')" id="tab-btn-cards" class="pb-3 text-sm font-bold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2">
          <i data-lucide="id-card" class="w-4 h-4"></i>
          <span>獨立薪資單預覽與下載</span>
        </button>
      </div>
      <div class="flex items-center space-x-2 pb-2" id="table-toolbar">
        <button onclick="openAddModal()" class="flex items-center space-x-1.5 px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-lg transition">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>手動新增員工</span>
        </button>
        <button onclick="clearAllData()" class="flex items-center space-x-1.5 px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold rounded-lg transition">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
          <span>清空所有資料</span>
        </button>
      </div>
    </div>

    <!-- 頁籤一：薪資總表編輯 -->
    <div id="tab-content-table" class="space-y-4">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto max-h-[620px]">
          <table class="w-full text-xs text-left border-collapse" id="main-salary-table">
            <thead class="bg-slate-50 text-slate-700 uppercase tracking-wider sticky top-0 shadow-sm z-10 font-bold border-b border-slate-300">
              <tr>
                <th rowspan="2" class="px-3 py-2.5 border-r border-slate-200 text-center bg-slate-100 min-w-[90px]">員工編號</th>
                <th rowspan="2" class="px-3 py-2.5 border-r border-slate-200 text-center bg-slate-100 min-w-[90px]">姓名</th>
                <th colspan="7" class="px-3 py-1.5 border-r border-slate-300 text-center bg-sky-50 text-sky-900 border-b border-sky-200">應發金額 (A)</th>
                <th colspan="6" class="px-3 py-1.5 border-r border-slate-300 text-center bg-rose-50 text-rose-900 border-b border-rose-200">應扣金額 (B)</th>
                <th rowspan="2" class="px-3 py-2.5 border-r border-slate-200 text-center bg-emerald-50 text-emerald-950 min-w-[95px]">合計<br>(A)-(B)</th>
                <th rowspan="2" class="px-3 py-2.5 border-r border-slate-200 text-center min-w-[130px]">備註</th>
                <th rowspan="2" class="px-3 py-2.5 text-center min-w-[80px] bg-slate-100">操作</th>
              </tr>
              <tr class="bg-slate-50">
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[80px]">固定薪資</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[70px]">伙食津</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[65px]">加班</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[65px]">獎金</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[65px]">自提退</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[75px]">其他加項</th>
                <th class="px-2 py-1.5 border-r border-slate-300 text-center min-w-[80px] bg-sky-100/60 font-black text-sky-950">加項小計</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[65px]">請假</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[70px]">勞保費</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[70px]">健保費</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[65px]">自提退</th>
                <th class="px-2 py-1.5 border-r border-slate-200 text-center min-w-[75px]">其他減項</th>
                <th class="px-2 py-1.5 border-r border-slate-300 text-center min-w-[80px] bg-rose-100/60 font-black text-rose-950">減項小計</th>
              </tr>
            </thead>
            <tbody id="table-body" class="divide-y divide-slate-200 bg-white">
              <!-- 動態渲染資料 -->
            </tbody>
            <tfoot id="table-foot" class="bg-slate-100 font-bold border-t-2 border-slate-300 sticky bottom-0 text-slate-800">
              <!-- 彙總總計 -->
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- 頁籤二：獨立薪資單預覽與下載 -->
    <div id="tab-content-cards" class="space-y-5 hidden">
      <div class="bg-white p-4 rounded-xl border border-slate-200 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center space-x-3">
          <label class="text-sm font-semibold text-slate-600">選擇員工預覽：</label>
          <select id="preview-select" onchange="renderCurrentPreview()" class="px-3 py-1.5 border border-slate-300 rounded-lg text-sm bg-white font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <!-- 動態填入員工選項 -->
          </select>
          <div class="flex items-center space-x-1">
            <button onclick="prevEmployee()" class="p-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
            <button onclick="nextEmployee()" class="p-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
          </div>
        </div>

        <div class="flex items-center space-x-2">
          <button onclick="downloadCurrentPNG()" class="flex items-center space-x-1.5 px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
            <i data-lucide="image" class="w-4 h-4"></i>
            <span>下載此張圖片 (PNG)</span>
          </button>
          <button onclick="downloadCurrentPDF()" class="flex items-center space-x-1.5 px-3.5 py-2 bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
            <i data-lucide="file-down" class="w-4 h-4"></i>
            <span>下載此張 PDF</span>
          </button>
          <button onclick="printCurrentEmployee()" class="flex items-center space-x-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold rounded-lg shadow-sm transition">
            <i data-lucide="printer" class="w-4 h-4"></i>
            <span>僅列印此張薪資條</span>
          </button>
        </div>
      </div>

      <!-- Canvas 即時渲染顯示區域 -->
      <div class="flex justify-center p-6 bg-slate-200/60 rounded-2xl border border-slate-300/80 overflow-x-auto">
        <canvas id="preview-canvas" class="bg-white rounded-xl shadow-lg max-w-full h-auto"></canvas>
      </div>
    </div>
  </main>

  <!-- 系統專用隱藏畫布 (用於高解析度批次渲染) -->
  <canvas id="export-canvas" style="display: none;"></canvas>

  <!-- 列印專用區域 -->
  <div id="print-area" class="hidden"></div>

  <!-- 編輯/新增員工 Modal 視窗 -->
  <div id="employee-modal" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center hidden backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full mx-4 overflow-hidden transform transition-all">
      <div class="px-6 py-4 bg-slate-900 text-white flex justify-between items-center">
        <h3 class="font-bold text-base" id="modal-title">新增員工薪資</h3>
        <button onclick="closeModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form id="employee-form" onsubmit="handleSaveEmployee(event)" class="p-6 space-y-4 max-h-[80vh] overflow-y-auto">
        <input type="hidden" id="form-id">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">員工編號 *</label>
            <input type="text" id="form-code" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">姓名 *</label>
            <input type="text" id="form-name" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
        </div>

        <!-- 應發項目 (A) -->
        <div class="bg-sky-50/70 p-3.5 rounded-xl border border-sky-100">
          <p class="text-xs font-bold text-sky-900 mb-2">應發項目 (A)</p>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">固定薪資</label>
              <input type="number" id="form-baseSalary" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">伙食津</label>
              <input type="number" id="form-mealAllowance" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">加班</label>
              <input type="number" id="form-overtime" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">獎金</label>
              <input type="number" id="form-bonus" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">自提退</label>
              <input type="number" id="form-pensionPlus" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">其他加項</label>
              <input type="number" id="form-otherPlus" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
          </div>
        </div>

        <!-- 應扣項目 (B) -->
        <div class="bg-rose-50/70 p-3.5 rounded-xl border border-rose-100">
          <p class="text-xs font-bold text-rose-900 mb-2">應扣項目 (B)</p>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">請假</label>
              <input type="number" id="form-leaveDeduction" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">勞保費</label>
              <input type="number" id="form-laborInsurance" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">健保費</label>
              <input type="number" id="form-healthInsurance" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">自提退</label>
              <input type="number" id="form-pensionMinus" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
            <div>
              <label class="block text-[11px] text-slate-600 mb-0.5">其他減項</label>
              <input type="number" id="form-otherMinus" value="0" class="w-full px-2.5 py-1.5 text-sm border border-slate-300 rounded bg-white">
            </div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">備註說明</label>
          <input type="text" id="form-note" placeholder="例如：補發7月伙食津貼 / 請假扣款明細" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
        </div>

        <div class="pt-2 flex justify-end space-x-2">
          <button type="button" onclick="closeModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition">取消</button>
          <button type="submit" class="px-5 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg shadow transition">儲存資料</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Loading 指示遮罩 -->
  <div id="loading-overlay" class="fixed inset-0 bg-slate-900/70 z-50 flex items-center justify-center hidden backdrop-blur-sm text-white flex-col space-y-4">
    <div class="animate-spin rounded-full h-12 w-12 border-4 border-white border-t-transparent"></div>
    <p id="loading-text" class="text-sm font-semibold tracking-wider">正在處理中，請稍候...</p>
  </div>

  <script>
    // 預設資料集 (初始化範例)
    let salaryData = [
      {
        id: "emp-1",
        code: "JBE26001",
        name: "蕭宥萱",
        baseSalary: 73000,
        mealAllowance: 3000,
        overtime: 0,
        bonus: 0,
        pensionPlus: 0,
        otherPlus: 0,
        leaveDeduction: 0,
        laborInsurance: 1145,
        healthInsurance: 1187,
        pensionMinus: 0,
        otherMinus: 0,
        note: ""
      },
      {
        id: "emp-2",
        code: "JBE26038",
        name: "陳建豪",
        baseSalary: 42000,
        mealAllowance: 3000,
        overtime: 2450,
        bonus: 5000,
        pensionPlus: 0,
        otherPlus: 500,
        leaveDeduction: 0,
        laborInsurance: 966,
        healthInsurance: 720,
        pensionMinus: 0,
        otherMinus: 0,
        note: "績效獎金+全勤"
      },
      {
        id: "emp-3",
        code: "JBE26042",
        name: "林雅婷",
        baseSalary: 38000,
        mealAllowance: 3000,
        overtime: 0,
        bonus: 0,
        pensionPlus: 0,
        otherPlus: 0,
        leaveDeduction: 1267,
        laborInsurance: 874,
        healthInsurance: 651,
        pensionMinus: 2280,
        otherMinus: 200,
        note: "事假1天，自提6%"
      }
    ];

    let currentSelectedId = salaryData[0]?.id || "";

    // 格式化數字為千分位
    function formatMoney(num) {
      if (num === null || num === undefined || isNaN(num)) return "-";
      if (Number(num) === 0) return "0";
      return Number(num).toLocaleString('en-US');
    }

    // 計算加項小計
    function calcGross(emp) {
      return (Number(emp.baseSalary) || 0) +
             (Number(emp.mealAllowance) || 0) +
             (Number(emp.overtime) || 0) +
             (Number(emp.bonus) || 0) +
             (Number(emp.pensionPlus) || 0) +
             (Number(emp.otherPlus) || 0);
    }

    // 計算減項小計 (包含其他減項)
    function calcDeduction(emp) {
      return (Number(emp.leaveDeduction) || 0) +
             (Number(emp.laborInsurance) || 0) +
             (Number(emp.healthInsurance) || 0) +
             (Number(emp.pensionMinus) || 0) +
             (Number(emp.otherMinus) || 0);
    }

    // 計算實發金額 (A)-(B)
    function calcNet(emp) {
      return calcGross(emp) - calcDeduction(emp);
    }

